# ── Backend ─────────────────────────────────────────────
# Pooled Neon connection string (runtime).
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/agrimind?sslmode=require
# Direct Neon connection string (Alembic migrations only).
DATABASE_URL_DIRECT=postgresql://user:password@host.region.aws.neon.tech/agrimind?sslmode=require

# Must be at least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=replace-me-with-a-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

APP_ENV=development
LOG_LEVEL=INFO

# Comma-free JSON list of allowed admin origins.
CORS_ORIGINS=["http://localhost:5173"]

# ── Admin (Vite) ────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ── Mobile (Expo) ───────────────────────────────────────
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
